# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — per-user local settings (never shared)
.claude/settings.local.json

# playwright MCP session artifacts + local screenshots.
# Root-level captures are scratch by default — /*.png was already ignored,
# but .jpeg was not, which is how 77 design frames (16 MB) ended up tracked
# in the repo root. Keepers belong in docs/screenshots/ (git mv, not copy).
.playwright-mcp/
/*.png
/*.jpg
/*.jpeg

# playwright session artifacts (review agents)
.playwright-cli/
.playwright-mcp/
