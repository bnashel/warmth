# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Mapbox — needed once the map renders. Get a public token at
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase — the project URL and public anon key (RLS-gated, safe to expose).
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
